<Window x:Class="PingWatch.ConfigEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PingWatch"
        mc:Ignorable="d"
        Title="Device Configuration" Height="400" Width="500" WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <StackPanel Margin="3">
            <DataGrid x:Name="deviceGrid" AutoGenerateColumns="False" CanUserAddRows="True" CanUserDeleteRows="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Ad" Binding="{Binding Name, Mode=TwoWay}" Width="*"/>
                    <DataGridTextColumn Header="IP" Binding="{Binding IP, Mode=TwoWay}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <Button Content="Save and Close" Height="30" Margin="0,10,0,0" HorizontalAlignment="Right" Width="150" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>